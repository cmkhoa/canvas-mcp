# Copy to .env and fill in. Never commit .env.
CANVAS_API_URL=https://your-school.instructure.com/api/v1
CANVAS_API_TOKEN=
# Optional: IANA zone for showing dates (defaults to this computer's zone)
# CANVAS_TIMEZONE=America/Chicago

# --- If your school doesn't let you create API tokens ---
# Leave CANVAS_API_TOKEN empty and set CANVAS_SESSION_COOKIE instead (only use this where your
# school's rules allow it). To get it: sign in to Canvas in your browser, open DevTools
# (Cmd+Option+I) → Network, reload, click any request to your Canvas site, and copy the value of
# the "Cookie" request header. Treat it like your password: it signs in as you. It stops working
# when you sign out or the session expires; copy a fresh one then.
# Keep the single quotes: cookies often contain $ and spaces.
# CANVAS_SESSION_COOKIE='canvas_session=...; _csrf_token=...'
